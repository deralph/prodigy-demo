# =======================================================================
# PRODIGY FINANCE — BACKEND ENVIRONMENT VARIABLES
# =======================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# FREE CLOUD SERVICES USED:
#   PostgreSQL  → Supabase   https://supabase.com        (free 500 MB)
#   File Store  → Cloudinary https://cloudinary.com     (free 25 GB)
#   Email       → Gmail SMTP https://myaccount.google.com/apppasswords
#   Payments    → Paystack   https://dashboard.paystack.com
# =======================================================================


# ── Database (Supabase PostgreSQL — free 500 MB) ───────────────────
#
# SETUP STEPS:
#   1. Go to https://supabase.com and sign up (free, no card needed)
#   2. Click "New project" → fill in Name, Database Password, Region
#      → pick the closest region (e.g. West EU / US East)
#   3. Wait ~2 minutes for the project to provision
#   4. Go to: Project Settings → Database → Connection string
#   5. Select the "URI" tab
#      - Switch the port to 6543  → copy as DATABASE_URL  (pooled / pgbouncer)
#      - Switch the port to 5432  → copy as DIRECT_URL    (direct connection)
#   6. Replace [YOUR-PASSWORD] with the password you chose in step 2
#
# DATABASE_URL  (port 6543 — used at runtime, via pgbouncer)
#   postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL    (port 5432 — used by Prisma migrate only)
#   postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ── JWT ───────────────────────────────────────────────────────────
#
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
JWT_SECRET="paste-a-64-byte-hex-secret-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="paste-a-different-64-byte-hex-secret-here"
JWT_REFRESH_EXPIRES_IN="7d"


# ── App ───────────────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"
# Set to your deployed frontend URL in production:
FRONTEND_URL="http://localhost:5173"


# ── Cloudinary (KYC document & file storage) ──────────────────────
#
# SETUP STEPS:
#   1. Go to https://cloudinary.com and create a free account
#   2. From the Dashboard, copy your Cloud Name, API Key, and API Secret
#
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"


# ── Paystack (wallet funding & payments) ──────────────────────────
#
# SETUP STEPS:
#   1. Go to https://dashboard.paystack.com and sign up
#   2. Navigate to Settings → API Keys & Webhooks
#   3. Copy your test Secret Key and Public Key
#   4. Set your webhook URL to: https://your-backend-url/api/v1/webhooks/paystack
#
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="your-paystack-webhook-secret"


# ── Email (Gmail SMTP via Nodemailer) ────────────────────────────
#
# SETUP STEPS:
#   1. Use a Gmail account dedicated to this app
#   2. Enable 2-Factor Authentication on the account
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Create an App Password for "Mail" → copy the 16-character password
#   5. Paste it as SMTP_PASS below (no spaces)
#
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"
EMAIL_FROM="Prodigy Finance <noreply@prodigyfinance.ng>"


# ── Rate Limiting ─────────────────────────────────────────────────
# THROTTLE_TTL: window size in seconds
# THROTTLE_LIMIT: max requests per window per IP
THROTTLE_TTL=60
THROTTLE_LIMIT=100


# ── Redis (optional — only needed if BullMQ queues are enabled) ───
#
# If you enable background job queues later, use Upstash Redis (free):
#   1. Go to https://upstash.com and create a free Redis database
#   2. Copy the Redis URL from the Upstash console
#   Format: rediss://default:your-password@your-endpoint.upstash.io:6379
#
REDIS_URL="redis://localhost:6379"

# ── QoreID (BVN verification) ─────────────────────────────────────
# Used during individual / joint onboarding to verify BVN ownership.
# Raw BVNs are never stored; set BVN_HASH_PEPPER to a long random secret
# dedicated to keyed BVN fingerprints.
QOREID_BASE_URL="https://api.qoreid.com"
QOREID_CLIENT_ID="your-qoreid-client-id"
QOREID_SECRET="your-qoreid-secret"
QOREID_TIMEOUT_MS=10000
BVN_HASH_PEPPER="paste-a-different-64-byte-hex-secret-here"
# Set to true only for local demos when QoreID credentials are unavailable.
QOREID_ALLOW_DEMO_VERIFICATION=false

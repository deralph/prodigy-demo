# ── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/prodigy_finance?schema=public"

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="another-long-random-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# ── App ───────────────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# ── Redis (BullMQ / Socket.io adapter) ────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── AWS S3 (document storage) ─────────────────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="prodigy-kyc-documents"

# ── Paystack ──────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="your-paystack-webhook-secret"

# ── SendGrid (email) ──────────────────────────────────────────────
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@prodigyfinance.ng"

# ── Termii (SMS OTP) ──────────────────────────────────────────────
TERMII_API_KEY="your-termii-api-key"
TERMII_SENDER_ID="Prodigy"

# ── Rate Limiting ─────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

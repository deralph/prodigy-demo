generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id                 String              @id @default(cuid())
  clientRef          String              @unique
  type               ClientType
  status             ClientStatus        @default(PENDING_KYC)
  name               String
  email              String              @unique
  phone              String?
  address            String?
  city               String?
  state              String?
  country            String              @default("Nigeria")
  rcNumber           String?
  taxId              String?
  scumlCert          String?
  secondaryName      String?
  secondaryEmail     String?
  secondaryPhone     String?
  mandateType        MandateType?        @default(AND)
  walletBalance      BigInt              @default(0)
  pendingBalance     BigInt              @default(0)
  virtualAccountNo   String?
  virtualAccountBank String?
  entityId           String?             // Business entity for regulatory separation (PFL, PP Advisers, etc.)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  activityLog        ActivityLog[]
  approvals          Approval[]
  authUsers          AuthUser[]
  beneficiaries      Beneficiary[]
  investments        Investment[]
  identityVerifications IdentityVerification[]
  kycDocuments       KycDocument[]
  kycRecord          KycRecord?
  riskProfile        RiskProfile?
  staffLoans         StaffLoan[]
  walletTransactions WalletTransaction[]
  orgLedgerEntries   OrgLedger[]
  withholdingTax     WithholdingTax[]
  entity             Entity?             @relation(fields: [entityId], references: [id])

  @@index([type])
  @@index([status])
  @@index([email])
  @@index([entityId])
}

model AuthUser {
  id                   String     @id @default(cuid())
  email                String     @unique
  passwordHash         String
  role                 String
  isActive             Boolean    @default(true)
  lastLoginAt          DateTime?
  refreshToken         String?
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  passwordResetTokenPrefix String? // First 8 chars of raw token for indexed lookup
  otpCode              String?
  otpExpiry            DateTime?
  passwordChangedAt    DateTime?  // Track when password was last changed
  passwordExpired      Boolean    @default(false)  // Flag for expired passwords
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  clientId             String?
  adminUserId          String?    @unique
  holderType           HolderType @default(PRIMARY)
  adminUser            AdminUser? @relation(fields: [adminUserId], references: [id])
  client               Client?    @relation(fields: [clientId], references: [id])
  sessions             Session[]

  @@index([email])
  @@index([clientId])
  @@index([passwordResetToken])
  @@index([passwordResetTokenPrefix])
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  authUserId String
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  authUser   AuthUser @relation(fields: [authUserId], references: [id], onDelete: Cascade)

  @@index([authUserId])
}

model AdminUser {
  id           String      @id @default(cuid())
  adminRef     String      @unique
  name         String
  email        String      @unique
  role         AdminRole
  status       AdminStatus @default(ACTIVE)
  department   String?
  permissions  Json        @default("[]")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  createdById  String?
  auditEntries AuditLog[]
  authUser     AuthUser?

  @@index([role])
  @@index([status])
}

model KycRecord {
  id           String    @id @default(cuid())
  clientId     String    @unique
  status       KycStatus @default(PENDING)
  reviewedById String?
  reviewNotes  String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client    @relation(fields: [clientId], references: [id])
}

model KycDocument {
  id              String       @id @default(cuid())
  clientId        String
  docKey          String
  label           String
  fileUrl         String?
  fileName        String?
  fileMimeType    String?
  fileSizeBytes   Int?
  status          KycDocStatus @default(NOT_UPLOADED)
  uploadedAt      DateTime?
  verifiedAt      DateTime?
  verifiedById    String?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  client          Client       @relation(fields: [clientId], references: [id])

  @@unique([clientId, docKey])
  @@index([clientId])
  @@index([status])
}

model IdentityVerification {
  id                String   @id @default(cuid())
  clientId          String
  type              String
  identifierHash    String
  nameNormalized    String
  provider          String
  providerReference String?
  verifiedAt        DateTime
  createdAt         DateTime @default(now())
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([type, identifierHash])
}

model Product {
  id                 String        @id @default(cuid())
  code               String        @unique
  name               String
  category           String?
  description        String?
  roiMin             Decimal       @db.Decimal(5, 2)
  roiMax             Decimal       @db.Decimal(5, 2)
  minInvestKobo      BigInt
  maxInvestKobo      BigInt?
  lockInDays         Int?
  lockInStr          String?
  withholdingTaxRate Decimal       @default(10.00) @db.Decimal(5, 2)
  earlyExitPenalty   Decimal?      @db.Decimal(5, 2)
  clientTypes        String[]      @default([])
  riskLevel          String?
  hasTenor           Boolean       @default(false)
  tenorOptions       String[]      @default([])
  color              String?
  isNegotiated       Boolean       @default(false)
  status             ProductStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  updatedById        String?
  approvals          Approval[]
  dividends          Dividend[]
  investments        Investment[]

  @@index([status])
  @@index([category])
}

model Investment {
  id              String            @id @default(cuid())
  investRef       String            @unique
  clientId        String
  productId       String
  status          InvestmentStatus  @default(PENDING_APPROVAL)
  principalKobo   BigInt
  roiRate         Decimal           @db.Decimal(5, 2)
  taxRate         Decimal           @default(10.00) @db.Decimal(5, 2)
  tenorDays       Int
  valueDate       DateTime?
  maturityDate    DateTime?
  bookedById      String?
  bookedAt        DateTime?
  approvedById    String?
  approvedAt      DateTime?
  notes           String?
  isInternal      Boolean           @default(false)
  interestRedeemedKobo BigInt        @default(0)
  withholdingTaxKobo   BigInt        @default(0)
  netInterestPaidKobo  BigInt        @default(0)
  entityId        String?           // Business entity for regulatory separation
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  approval        Approval?
  dividendEntries DividendEntry[]
  client          Client            @relation(fields: [clientId], references: [id])
  product         Product           @relation(fields: [productId], references: [id])
  history         InvestmentEvent[]
  preTermination  PreTermination?
  walletTransactions WalletTransaction[]
  withholdingTax   WithholdingTax[]
  entity          Entity?           @relation(fields: [entityId], references: [id])

  @@index([clientId])
  @@index([productId])
  @@index([status])
  @@index([maturityDate])
  @@index([isInternal])
  @@index([entityId])
  @@index([clientId, status])
  @@index([clientId, isInternal, status])
  @@index([status, maturityDate])
  @@index([clientId, createdAt])
}

model InvestmentEvent {
  id            String     @id @default(cuid())
  investmentId  String
  action        String
  note          String?
  performedById String?
  occurredAt    DateTime   @default(now())
  investment    Investment @relation(fields: [investmentId], references: [id])

  @@index([investmentId])
}

model Approval {
  id           String         @id @default(cuid())
  approvalRef  String         @unique
  type         ApprovalType
  status       ApprovalStatus @default(PENDING)
  clientId     String?
  investmentId String?        @unique
  productId    String?
  amountKobo   BigInt?
  details      Json?
  submittedAt  DateTime       @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewNotes  String?
  client       Client?        @relation(fields: [clientId], references: [id])
  investment   Investment?    @relation(fields: [investmentId], references: [id])
  product      Product?       @relation(fields: [productId], references: [id])

  @@index([type])
  @@index([status])
  @@index([clientId])
}

model WalletTransaction {
  id                    String            @id @default(cuid())
  txnRef                String            @unique
  clientId              String
  type                  TransactionType
  status                TransactionStatus @default(PENDING)
  amountKobo            BigInt
  approvedAmountKobo    BigInt?
  disbursedAmountKobo   BigInt?
  description           String?
  paystackRef           String?
  paystackTransferCode  String?
  failureReason         String?
  bankName              String?
  bankAcctNo            String?
  bankAcctName          String?
  initiatedById            String?
  requestedByAuthUserId    String?
  approvedById             String?
  requiresCoSign           Boolean           @default(false)
  coSignedByAuthUserId     String?
  coSignedAt               DateTime?
  processedAt              DateTime?
  approvedAt               DateTime?
  entityId                 String?           // Business entity for regulatory separation
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  client                   Client            @relation(fields: [clientId], references: [id])
  investment               Investment?       @relation(fields: [investmentId], references: [id])
  relatedTransaction       WalletTransaction? @relation("TransactionReversal", fields: [relatedTransactionId], references: [id])
  relatedTransactions      WalletTransaction[] @relation("TransactionReversal")
  investmentId             String?
  relatedTransactionId     String?
  supportingDocuments      Json?
  metadata                 Json?
  entity                   Entity?           @relation(fields: [entityId], references: [id])

  @@index([clientId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([investmentId])
  @@index([initiatedById])
  @@index([approvedById])
  @@index([relatedTransactionId])
  @@index([entityId])
  @@index([clientId, status, createdAt])
  @@index([clientId, type, status, createdAt])
}

model PreTermination {
  id                  String            @id @default(cuid())
  preTermRef          String            @unique
  investmentId        String            @unique
  clientId            String
  status              PreTermStatus     @default(PENDING_OPS)
  requestedAmountKobo BigInt
  penaltyKobo         BigInt            @default(0)
  netPayoutKobo       BigInt
  reason              String?
  requestedAt         DateTime          @default(now())
  opsApprovedById     String?
  opsApprovedAt       DateTime?
  financeApprovedById String?
  financeApprovedAt   DateTime?
  disbursedAt         DateTime?
  rejectedById        String?
  rejectedAt          DateTime?
  rejectionReason     String?
  entityId            String?           // Business entity for regulatory separation
  financeQueueItem    FinanceQueueItem?
  investment          Investment        @relation(fields: [investmentId], references: [id])
  entity              Entity?           @relation(fields: [entityId], references: [id])

  @@index([clientId])
  @@index([status])
  @@index([entityId])
}

model OrgLedger {
  id           String   @id @default(cuid())
  entryRef     String   @unique
  type         String
  description  String?
  amountKobo   BigInt
  clientId     String?
  preTermId    String?
  fqItemId     String?
  recordedById String?
  entityId     String?   // Business entity for regulatory separation
  createdAt    DateTime @default(now())

  client       Client?   @relation(fields: [clientId], references: [id])
  entity       Entity?   @relation(fields: [entityId], references: [id])

  @@index([type])
  @@index([createdAt])
  @@index([entityId])
}

model WithholdingTax {
  id                 String      @id @default(cuid())
  wtRef              String      @unique
  investmentId       String
  clientId           String
  grossInterestKobo  BigInt
  taxKobo            BigInt
  netInterestKobo    BigInt
  taxRate            Decimal     @db.Decimal(5, 2)
  status             WithholdingTaxStatus @default(PENDING)
  collectedAt        DateTime?
  collectedById      String?
  entityId           String?      // Business entity for regulatory separation
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  investment         Investment  @relation(fields: [investmentId], references: [id])
  client             Client      @relation(fields: [clientId], references: [id])
  entity             Entity?     @relation(fields: [entityId], references: [id])

  @@index([clientId])
  @@index([investmentId])
  @@index([status])
  @@index([collectedAt])
  @@index([entityId])
}

enum WithholdingTaxStatus {
  PENDING
  COLLECTED
  REFUNDED
}

model FinanceQueueItem {
  id              String             @id @default(cuid())
  fqRef           String             @unique
  type            String
  status          FinanceQueueStatus @default(PENDING)
  clientId        String
  amountKobo      BigInt
  penaltyKobo     BigInt             @default(0)
  notes           String?
  preTermId       String?            @unique
  requestedById   String?
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  entityId        String?            // Business entity for regulatory separation
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  preTermination  PreTermination?    @relation(fields: [preTermId], references: [id])
  entity          Entity?            @relation(fields: [entityId], references: [id])

  @@index([clientId])
  @@index([status])
  @@index([entityId])
}

// Business Entity — for regulatory entity separation (e.g., PFL, PP Advisers Ltd)
// Legal mapping of clients/investments to entities must be provided by compliance team.
// This model provides the technical structure; actual assignments require legal review.
model Entity {
  id                String   @id @default(cuid())
  entityRef         String   @unique
  name              String
  code              String   @unique // e.g., "PFL", "PPA"
  description       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  clients           Client[]
  investments       Investment[]
  transactions      WalletTransaction[]
  preTerminations   PreTermination[]
  orgLedgerEntries  OrgLedger[]
  withholdingTax    WithholdingTax[]
  financeQueueItems FinanceQueueItem[]
  corporateEntities CorporateEntity[]
  staffLoans        StaffLoan[]
  dividends         Dividend[]
  activityLogs      ActivityLog[]
  auditLogs         AuditLog[]

  @@index([code])
  @@index([isActive])
}

model CorporateEntity {
  id         String      @id @default(cuid())
  entityRef  String      @unique
  name       String
  sector     String?
  staffCount Int         @default(0)
  clientId   String?
  entityId   String?     // Link to business Entity for regulatory separation
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  staffLoans StaffLoan[]
  entity     Entity?     @relation(fields: [entityId], references: [id])

  @@index([name])
  @@index([entityId])
}

model StaffLoan {
  id                 String          @id @default(cuid())
  loanRef            String          @unique
  corporateId        String
  clientId           String?
  staffName          String
  staffId            String?
  staffEmail         String?
  department         String?
  rejectionReason    String?
  principalKobo      BigInt
  interestRate       Decimal         @db.Decimal(5, 2)
  tenorMonths        Int
  monthlyPaymentKobo BigInt
  disbursedAt        DateTime?
  maturityDate       DateTime?
  status             LoanStatus      @default(PENDING)
  outstandingKobo    BigInt          @default(0)
  interestEarnedKobo BigInt          @default(0)
  entityId           String?         // Business entity for regulatory separation
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  repayments         LoanRepayment[]
  client             Client?         @relation(fields: [clientId], references: [id])
  corporate          CorporateEntity @relation(fields: [corporateId], references: [id])
  entity             Entity?         @relation(fields: [entityId], references: [id])

  @@index([corporateId])
  @@index([status])
  @@index([entityId])
}

model LoanRepayment {
  id         String    @id @default(cuid())
  loanId     String
  amountKobo BigInt
  paidAt     DateTime  @default(now())
  note       String?
  loan       StaffLoan @relation(fields: [loanId], references: [id])

  @@index([loanId])
}

model Dividend {
  id              String          @id @default(cuid())
  dividendRef     String          @unique
  productId       String
  rate            Decimal         @db.Decimal(5, 2)
  totalPayoutKobo BigInt
  eligibleCount   Int
  declarationDate DateTime
  paymentDate     DateTime?
  notes           String?
  status          DividendStatus  @default(DECLARED)
  declaredById    String
  entityId        String?         // Business entity for regulatory separation
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  product         Product         @relation(fields: [productId], references: [id])
  entries         DividendEntry[]
  entity          Entity?         @relation(fields: [entityId], references: [id])

  @@index([productId])
  @@index([status])
  @@index([entityId])
}

model DividendEntry {
  id           String     @id @default(cuid())
  dividendId   String
  investmentId String
  clientId     String
  amountKobo   BigInt
  paidAt       DateTime?
  dividend     Dividend   @relation(fields: [dividendId], references: [id])
  investment   Investment @relation(fields: [investmentId], references: [id])

  @@index([dividendId])
  @@index([clientId])
}

model Beneficiary {
  id           String   @id @default(cuid())
  clientId     String
  name         String
  relationship String?
  email        String?
  phone        String?
  percentage   Decimal  @default(0) @db.Decimal(5, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id])

  @@index([clientId])
}

model RiskProfile {
  id         String   @id @default(cuid())
  clientId   String   @unique
  riskLevel  String
  score      Int?
  assessedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  notes      String?
  client     Client   @relation(fields: [clientId], references: [id])
}

model ActivityLog {
  id          String   @id @default(cuid())
  clientId    String
  action      String
  description String?
  amountKobo  BigInt?
  metadata    Json?
  entityId    String?   // Business entity for regulatory separation
  occurredAt  DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id])
  entity      Entity?   @relation(fields: [entityId], references: [id])

  @@index([clientId])
  @@index([occurredAt])
  @@index([entityId])
}

model AuditLog {
  id           String        @id @default(cuid())
  auditRef     String        @unique @default(cuid())
  adminId      String?
  adminName    String
  adminRole    String
  action       String
  targetEntity String?
  category     AuditCategory
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  entityId     String?       // Business entity for regulatory separation
  occurredAt   DateTime      @default(now())
  admin        AdminUser?    @relation(fields: [adminId], references: [id])
  entity       Entity?       @relation(fields: [entityId], references: [id])

  @@index([adminId])
  @@index([category])
  @@index([entityId])
}

model AuditToken {
  id         String    @id @default(cuid())
  token      String    @unique
  clientId   String
  email      String
  usedAt     DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([clientId])
  @@index([expiresAt])
}

enum ClientType {
  CORPORATE
  INDIVIDUAL
  JOINT
}

enum ClientStatus {
  PENDING_KYC
  KYC_SUBMITTED
  KYC_UNDER_REVIEW
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MandateType {
  AND
  OR
}

enum HolderType {
  PRIMARY
  SECONDARY
}

enum KycDocStatus {
  NOT_UPLOADED
  UPLOADED
  VERIFIED
  REJECTED
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  FLAGGED
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  COMPLIANCE
  FINANCE
  AUDIT
  INVESTMENT
}

enum AdminStatus {
  ACTIVE
  LOCKED
  DELETED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InvestmentStatus {
  PENDING_APPROVAL
  ACTIVE
  MATURED
  PRE_TERMINATED
  REJECTED
  CLOSED
  PAID_OUT
}

enum ApprovalType {
  KYC
  SUBSCRIPTION
  REDEMPTION
  PRE_TERMINATION
  STAFF_LOAN
  DIVIDEND
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  WALLET_FUNDING
  WALLET_WITHDRAWAL
  SUBSCRIPTION
  REDEMPTION
  PRE_TERMINATION_PAYOUT
  DIVIDEND_PAYOUT
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  FEE
  INTEREST
}

enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REVERSED
}

enum PreTermStatus {
  PENDING_OPS
  APPROVED_OPS
  PENDING_FINANCE
  DISBURSED
  REJECTED
}

enum FinanceQueueStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
}

enum LoanStatus {
  PENDING
  ACTIVE
  REJECTED
  REPAID
  DEFAULTED
  OVERDUE
  RESTRUCTURED
}

enum DividendStatus {
  DECLARED
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum AuditCategory {
  AUTH
  KYC
  INVESTMENT
  FINANCE
  OPERATIONS
  COMPLIANCE
  SYSTEM
  AUDIT
}

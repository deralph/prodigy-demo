generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id                 String              @id @default(cuid())
  clientRef          String              @unique
  type               ClientType
  status             ClientStatus        @default(PENDING_KYC)
  name               String
  email              String              @unique
  phone              String?
  address            String?
  city               String?
  state              String?
  country            String              @default("Nigeria")
  rcNumber           String?
  taxId              String?
  scumlCert          String?
  secondaryName      String?
  secondaryEmail     String?
  secondaryPhone     String?
  mandateType        MandateType?        @default(AND)
  walletBalance      BigInt              @default(0)
  pendingBalance     BigInt              @default(0)
  virtualAccountNo   String?
  virtualAccountBank String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  activityLog        ActivityLog[]
  approvals          Approval[]
  authUser           AuthUser?
  beneficiaries      Beneficiary[]
  goals              Goal[]
  investments        Investment[]
  identityVerifications IdentityVerification[]
  kycDocuments       KycDocument[]
  kycRecord          KycRecord?
  legacyNote         LegacyNote?
  riskProfile        RiskProfile?
  staffLoans         StaffLoan[]
  statements         Statement[]
  walletTransactions WalletTransaction[]

  @@index([type])
  @@index([status])
  @@index([email])
}

model AuthUser {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  role                String
  isActive            Boolean    @default(true)
  lastLoginAt         DateTime?
  refreshToken        String?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  otpCode             String?
  otpExpiry           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  clientId            String?    @unique
  adminUserId         String?    @unique
  adminUser           AdminUser? @relation(fields: [adminUserId], references: [id])
  client              Client?    @relation(fields: [clientId], references: [id])
  sessions            Session[]

  @@index([email])
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  authUserId String
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  authUser   AuthUser @relation(fields: [authUserId], references: [id], onDelete: Cascade)

  @@index([authUserId])
}

model AdminUser {
  id           String      @id @default(cuid())
  adminRef     String      @unique
  name         String
  email        String      @unique
  role         AdminRole
  status       AdminStatus @default(ACTIVE)
  department   String?
  permissions  Json        @default("[]")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  createdById  String?
  auditEntries AuditLog[]
  authUser     AuthUser?

  @@index([role])
  @@index([status])
}

model KycRecord {
  id           String    @id @default(cuid())
  clientId     String    @unique
  status       KycStatus @default(PENDING)
  reviewedById String?
  reviewNotes  String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client    @relation(fields: [clientId], references: [id])
}

model KycDocument {
  id              String       @id @default(cuid())
  clientId        String
  docKey          String
  label           String
  fileUrl         String?
  fileName        String?
  fileMimeType    String?
  fileSizeBytes   Int?
  status          KycDocStatus @default(NOT_UPLOADED)
  uploadedAt      DateTime?
  verifiedAt      DateTime?
  verifiedById    String?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  client          Client       @relation(fields: [clientId], references: [id])

  @@unique([clientId, docKey])
  @@index([clientId])
  @@index([status])
}

model IdentityVerification {
  id                String   @id @default(cuid())
  clientId          String
  type              String
  identifierHash    String
  nameNormalized    String
  provider          String
  providerReference String?
  verifiedAt        DateTime
  createdAt         DateTime @default(now())
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([type, identifierHash])
}

model Product {
  id                 String        @id @default(cuid())
  code               String        @unique
  name               String
  category           String?
  description        String?
  roiMin             Decimal       @db.Decimal(5, 2)
  roiMax             Decimal       @db.Decimal(5, 2)
  minInvestKobo      BigInt
  maxInvestKobo      BigInt?
  lockInDays         Int?
  lockInStr          String?
  withholdingTaxRate Decimal       @default(10.00) @db.Decimal(5, 2)
  earlyExitPenalty   Decimal?      @db.Decimal(5, 2)
  clientTypes        String[]      @default([])
  riskLevel          String?
  hasTenor           Boolean       @default(false)
  tenorOptions       String[]      @default([])
  color              String?
  isNegotiated       Boolean       @default(false)
  status             ProductStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  updatedById        String?
  approvals          Approval[]
  dividends          Dividend[]
  investments        Investment[]

  @@index([status])
  @@index([category])
}

model Investment {
  id              String            @id @default(cuid())
  investRef       String            @unique
  clientId        String
  productId       String
  status          InvestmentStatus  @default(PENDING_APPROVAL)
  principalKobo   BigInt
  roiRate         Decimal           @db.Decimal(5, 2)
  taxRate         Decimal           @default(10.00) @db.Decimal(5, 2)
  tenorDays       Int
  valueDate       DateTime
  maturityDate    DateTime
  autoRollover    Boolean           @default(false)
  bookedById      String?
  bookedAt        DateTime?
  approvedById    String?
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  approval        Approval?
  dividendEntries DividendEntry[]
  client          Client            @relation(fields: [clientId], references: [id])
  product         Product           @relation(fields: [productId], references: [id])
  history         InvestmentEvent[]
  preTermination  PreTermination?
  statement       Statement?

  @@index([clientId])
  @@index([productId])
  @@index([status])
  @@index([maturityDate])
}

model InvestmentEvent {
  id            String     @id @default(cuid())
  investmentId  String
  action        String
  note          String?
  performedById String?
  occurredAt    DateTime   @default(now())
  investment    Investment @relation(fields: [investmentId], references: [id])

  @@index([investmentId])
}

model Approval {
  id           String         @id @default(cuid())
  approvalRef  String         @unique
  type         ApprovalType
  status       ApprovalStatus @default(PENDING)
  clientId     String?
  investmentId String?        @unique
  productId    String?
  amountKobo   BigInt?
  details      Json?
  submittedAt  DateTime       @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewNotes  String?
  client       Client?        @relation(fields: [clientId], references: [id])
  investment   Investment?    @relation(fields: [investmentId], references: [id])
  product      Product?       @relation(fields: [productId], references: [id])

  @@index([type])
  @@index([status])
  @@index([clientId])
}

model WalletTransaction {
  id            String            @id @default(cuid())
  txnRef        String            @unique
  clientId      String
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  amountKobo    BigInt
  description   String?
  paystackRef   String?
  bankName      String?
  bankAcctNo    String?
  bankAcctName  String?
  initiatedById String?
  processedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  client        Client            @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model PreTermination {
  id                  String            @id @default(cuid())
  preTermRef          String            @unique
  investmentId        String            @unique
  clientId            String
  status              PreTermStatus     @default(PENDING_OPS)
  requestedAmountKobo BigInt
  penaltyKobo         BigInt            @default(0)
  netPayoutKobo       BigInt
  reason              String?
  requestedAt         DateTime          @default(now())
  opsApprovedById     String?
  opsApprovedAt       DateTime?
  financeApprovedById String?
  financeApprovedAt   DateTime?
  disbursedAt         DateTime?
  rejectedById        String?
  rejectedAt          DateTime?
  rejectionReason     String?
  financeQueueItem    FinanceQueueItem?
  investment          Investment        @relation(fields: [investmentId], references: [id])

  @@index([clientId])
  @@index([status])
}

model FinanceQueueItem {
  id              String             @id @default(cuid())
  fqRef           String             @unique
  type            String
  status          FinanceQueueStatus @default(PENDING)
  clientId        String
  amountKobo      BigInt
  penaltyKobo     BigInt             @default(0)
  notes           String?
  preTermId       String?            @unique
  requestedById   String?
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  preTermination  PreTermination?    @relation(fields: [preTermId], references: [id])

  @@index([clientId])
  @@index([status])
}

model CorporateEntity {
  id         String      @id @default(cuid())
  entityRef  String      @unique
  name       String
  sector     String?
  staffCount Int         @default(0)
  clientId   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  staffLoans StaffLoan[]

  @@index([name])
}

model StaffLoan {
  id                 String          @id @default(cuid())
  loanRef            String          @unique
  corporateId        String
  clientId           String?
  staffName          String
  staffEmail         String?
  department         String?
  principalKobo      BigInt
  interestRate       Decimal         @db.Decimal(5, 2)
  tenorMonths        Int
  monthlyPaymentKobo BigInt
  disbursedAt        DateTime?
  maturityDate       DateTime?
  status             LoanStatus      @default(PENDING)
  outstandingKobo    BigInt          @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  repayments         LoanRepayment[]
  client             Client?         @relation(fields: [clientId], references: [id])
  corporate          CorporateEntity @relation(fields: [corporateId], references: [id])

  @@index([corporateId])
  @@index([status])
}

model LoanRepayment {
  id         String    @id @default(cuid())
  loanId     String
  amountKobo BigInt
  paidAt     DateTime  @default(now())
  note       String?
  loan       StaffLoan @relation(fields: [loanId], references: [id])

  @@index([loanId])
}

model Dividend {
  id              String          @id @default(cuid())
  dividendRef     String          @unique
  productId       String
  rate            Decimal         @db.Decimal(5, 2)
  totalPayoutKobo BigInt
  eligibleCount   Int
  declarationDate DateTime
  paymentDate     DateTime?
  notes           String?
  status          DividendStatus  @default(DECLARED)
  declaredById    String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  product         Product         @relation(fields: [productId], references: [id])
  entries         DividendEntry[]

  @@index([productId])
  @@index([status])
}

model DividendEntry {
  id           String     @id @default(cuid())
  dividendId   String
  investmentId String
  clientId     String
  amountKobo   BigInt
  paidAt       DateTime?
  dividend     Dividend   @relation(fields: [dividendId], references: [id])
  investment   Investment @relation(fields: [investmentId], references: [id])

  @@index([dividendId])
  @@index([clientId])
}

model Goal {
  id               String     @id @default(cuid())
  clientId         String
  name             String
  targetAmountKobo BigInt
  currentKobo      BigInt     @default(0)
  targetDate       DateTime?
  status           GoalStatus @default(ON_TRACK)
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  client           Client     @relation(fields: [clientId], references: [id])

  @@index([clientId])
}

model Beneficiary {
  id           String   @id @default(cuid())
  clientId     String
  name         String
  relationship String?
  email        String?
  phone        String?
  percentage   Decimal  @default(0) @db.Decimal(5, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id])

  @@index([clientId])
}

model LegacyNote {
  id        String   @id @default(cuid())
  clientId  String   @unique
  content   String
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id])
}

model Statement {
  id           String     @id @default(cuid())
  investmentId String     @unique
  clientId     String
  fileUrl      String?
  generatedAt  DateTime   @default(now())
  holder       String?
  client       Client     @relation(fields: [clientId], references: [id])
  investment   Investment @relation(fields: [investmentId], references: [id])

  @@index([clientId])
}

model RiskProfile {
  id         String   @id @default(cuid())
  clientId   String   @unique
  riskLevel  String
  score      Int?
  assessedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  notes      String?
  client     Client   @relation(fields: [clientId], references: [id])
}

model ActivityLog {
  id          String   @id @default(cuid())
  clientId    String
  action      String
  description String?
  amountKobo  BigInt?
  metadata    Json?
  occurredAt  DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([occurredAt])
}

model AuditLog {
  id           String        @id @default(cuid())
  auditRef     String        @unique @default(cuid())
  adminId      String?
  adminName    String
  adminRole    String
  action       String
  targetEntity String?
  category     AuditCategory
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  occurredAt   DateTime      @default(now())
  admin        AdminUser?    @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([category])
  @@index([occurredAt])
}

model EodRun {
  id            String       @id @default(cuid())
  runDate       DateTime     @unique @db.Date
  status        EodRunStatus @default(RUNNING)
  triggeredById String
  steps         Json
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  errorMessage  String?

  @@index([runDate])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

enum ClientType {
  CORPORATE
  INDIVIDUAL
  JOINT
}

enum ClientStatus {
  PENDING_KYC
  KYC_SUBMITTED
  KYC_UNDER_REVIEW
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MandateType {
  AND
  OR
}

enum KycDocStatus {
  NOT_UPLOADED
  UPLOADED
  VERIFIED
  REJECTED
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  FLAGGED
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  COMPLIANCE
  FINANCE
  AUDIT
  INVESTMENT
}

enum AdminStatus {
  ACTIVE
  LOCKED
  DELETED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InvestmentStatus {
  PENDING_APPROVAL
  ACTIVE
  MATURED
  PRE_TERMINATED
  ROLLED_OVER
  REJECTED
}

enum ApprovalType {
  KYC
  SUBSCRIPTION
  REDEMPTION
  PRE_TERMINATION
  STAFF_LOAN
  DIVIDEND
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  WALLET_FUNDING
  WALLET_WITHDRAWAL
  SUBSCRIPTION
  REDEMPTION
  PRE_TERMINATION_PAYOUT
  DIVIDEND_PAYOUT
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  FEE
}

enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REVERSED
}

enum PreTermStatus {
  PENDING_OPS
  APPROVED_OPS
  PENDING_FINANCE
  DISBURSED
  REJECTED
}

enum FinanceQueueStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
}

enum LoanStatus {
  PENDING
  ACTIVE
  REPAID
  DEFAULTED
}

enum DividendStatus {
  DECLARED
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum EodRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  ACHIEVED
}

enum AuditCategory {
  AUTH
  KYC
  INVESTMENT
  FINANCE
  OPERATIONS
  COMPLIANCE
  SYSTEM
  AUDIT
}
